# Local development outside Docker (`make run`, `make worker`). `make env` copies it to backend/.env.
# The root .env (LLM key and the rest, used by Docker Compose) is read first; this file overrides it.
APP_STAGE=dev
DEBUG=true
LOG_LEVEL=INFO

# PostGIS and Redis from `make dev` (compose.dev.yml publishes these ports).
DATABASE_URL=postgresql+asyncpg://okno:okno@localhost:5432/okno
REDIS_URL=redis://localhost:6379/0

# `make keys` generates the pair into backend/secrets/.
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private_key.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public_key.pem

CORS_ALLOW_ORIGINS=http://localhost:5175
