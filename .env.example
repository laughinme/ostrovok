# О!кно — copy to .env: `cp .env.example .env`. Everything works without an LLM key.

# ── LLM (optional): any OpenAI-compatible endpoint. Empty key → rules-only mode. ──
# Jury key: decrypt secrets.env.age into .env (see README). Provider and model are listed in README.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MODEL_STRONG=
LLM_TIMEOUT_SEC=15
# auto | off — `off` forces the rules even with a key (also switchable in the console)
LLM_MODE=auto
LLM_DAILY_CALL_LIMIT=300

# ── Demo hotelier simulator ──
HOTELIER_SIMULATOR=on
SIMULATOR_DELAY_SEC=5-30

# ── Database (PostGIS) ──
POSTGRES_USER=okno
POSTGRES_PASSWORD=okno
POSTGRES_DB=okno

# ── App ──
APP_STAGE=dev
LOG_LEVEL=INFO
LOG_JSON=false
API_DOCS_ENABLED=true
CSRF_HMAC_KEY=okno-demo-csrf-key
