{
  "name": "luch-frontend",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . && npm run check:architecture && npm run check:comments",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
